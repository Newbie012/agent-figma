# Personal access token for local development. Prefer `auth login --token` on macOS,
# which stores the secret in Keychain.
AGENT_FIGMA_TOKEN=

# Optional for tests or a compatible proxy.
AGENT_FIGMA_API_BASE_URL=https://api.figma.com

# Hosted browser OAuth. Set this only to a trusted apps/oauth-relay deployment.
AGENT_FIGMA_OAUTH_RELAY_URL=
